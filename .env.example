NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Phase 2 — Discovery Engine (optional; falls back to mock data / mock scoring when unset)
MODASH_API_KEY=
ANTHROPIC_API_KEY=

# Phase 3 — Affiliate Tracking (optional; falls back to mock link data when DUB_API_KEY unset)
DUB_API_KEY=
DUB_WORKSPACE_ID=
N8N_CONVERSION_WEBHOOK_URL=
SHOPIFY_WEBHOOK_SECRET=

# Phase 4 — Payments (optional; falls back to mock Stripe Connect when STRIPE_SECRET_KEY unset)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=
N8N_PAYMENT_WEBHOOK_URL=

# Phase 5 — Influencer portal (optional; content approval + portal messaging still work locally
# without these, but invite acceptance won't link back to Supabase without CLERK_WEBHOOK_SECRET,
# and n8n alerts silently no-op without N8N_PORTAL_WEBHOOK_URL)
CLERK_WEBHOOK_SECRET=
N8N_PORTAL_WEBHOOK_URL=

# Phase 6 — Content Intelligence (optional; content capture/mentions/hashtags run against
# deterministic mock Modash data when MODASH_API_KEY is unset, same as Phase 2)
CRON_SECRET=
N8N_STORY_CAPTURE_WEBHOOK=
N8N_POST_CAPTURE_WEBHOOK=
N8N_MENTION_CHECK_WEBHOOK=
N8N_DIGEST_GENERATE_WEBHOOK=
DIGEST_EMAIL_RECIPIENTS=

# Affable.ai upgrade — Social account connections
# Instagram/YouTube are still stubbed (no OAuth app registered) — /settings/social-accounts
# reports which credentials are missing instead of completing a real handshake.
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok is a REAL OAuth connection (Login Kit v2, lib/social/tiktok.ts) — needs all
# three of these set to show as configured (lib/social/config.ts):
#   TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET — from your TikTok for Developers app
#   NEXT_PUBLIC_APP_URL — must exactly match the redirect URI registered with TikTok:
#     <NEXT_PUBLIC_APP_URL>/api/social/connect/tiktok/callback
#   ENCRYPTION_KEY — 32 bytes, base64 (generate with `openssl rand -base64 32`);
#     encrypts the access/refresh tokens before they're stored (lib/social/encryption.ts)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ENCRYPTION_KEY=
