NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Phase 2 — Discovery Engine (optional; falls back to mock data / mock scoring when unset)
MODASH_API_KEY=
ANTHROPIC_API_KEY=

# Phase 3 — Affiliate Tracking (optional; falls back to mock link data when DUB_API_KEY unset)
DUB_API_KEY=
DUB_WORKSPACE_ID=
N8N_CONVERSION_WEBHOOK_URL=
SHOPIFY_WEBHOOK_SECRET=

# Phase 4 — Payments (optional; falls back to mock Stripe Connect when STRIPE_SECRET_KEY unset)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=
N8N_PAYMENT_WEBHOOK_URL=

# Phase 5 — Influencer portal (optional; content approval + portal messaging still work locally
# without these, but invite acceptance won't link back to Supabase without CLERK_WEBHOOK_SECRET,
# and n8n alerts silently no-op without N8N_PORTAL_WEBHOOK_URL)
CLERK_WEBHOOK_SECRET=
N8N_PORTAL_WEBHOOK_URL=

# Phase 6 — Content Intelligence (optional; content capture/mentions/hashtags run against
# deterministic mock Modash data when MODASH_API_KEY is unset, same as Phase 2)
CRON_SECRET=
N8N_STORY_CAPTURE_WEBHOOK=
N8N_POST_CAPTURE_WEBHOOK=
N8N_MENTION_CHECK_WEBHOOK=
N8N_DIGEST_GENERATE_WEBHOOK=
DIGEST_EMAIL_RECIPIENTS=

# Affable.ai upgrade — Social account connections (optional; /settings/social-accounts
# renders and the schema works without these, but the "Connect" buttons are stubbed —
# no OAuth app is registered yet, so they report which credentials are missing instead
# of completing a real handshake)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOCIAL_OAUTH_CALLBACK_URL=
ENCRYPTION_KEY=
